# Passkey POC Server Environment Variables
# Copy this file to .env.local and fill in your values

# Android app SHA256 fingerprint (required)
# Get it with: keytool -list -v -keystore ~/.android/debug.keystore -storepass android
APP_SHA256_FINGERPRINT=XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX:XX

# Optional: Static ngrok domain (if you have one)
# If not set, ngrok will generate a random URL each time
# NGROK_DOMAIN=your-static-domain.ngrok-free.app
